####### ENVIRONMENTS #########
@APP_URL = http://localhost:8000/api/v1
@EMAIL = "user@example.com"
@PASSWORD = "password"

####### REF LINKS #######
# Rest requests demos https://raw.githubusercontent.com/Huachao/vscode-restclient/refs/heads/master/README.md
#######

###
# @name register
# Register a new user
POST {{APP_URL}}/register HTTP/1.1
Content-Type: application/json
Accept: application/json

{
    "name": "Test User",
    "email": "{{EMAIL}}",
    "password": "{{PASSWORD}}",
    "password_confirmation": "{{PASSWORD}}"
}

###
# @name login
# Login a user and get a token
POST {{APP_URL}}/login HTTP/1.1
Content-Type: application/json
Accept: application/json

{
    "email": "{{EMAIL}}",
    "password": "{{PASSWORD}}"
}

@token = {{login.response.body.token}}

###
# @name logout
# Logout the user
POST {{APP_URL}}/logout HTTP/1.1
Authorization: Bearer {{token}}
Accept: application/json
