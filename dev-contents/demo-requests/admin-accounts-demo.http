####### ENVIRONMENTS #########
@APP_URL=http://localhost:8000
@ADMIN_EMAIL=admin@mail.com
@ADMIN_PASSWORD=power@123
#######

####### REF LINKS #######
# Rest requests demos https://raw.githubusercontent.com/Huachao/vscode-restclient/refs/heads/master/README.md
#######

### Admin Login
# @name adminLogin
POST {{APP_URL}}/admin/login HTTP/1.1
Content-Type: application/json
Accept: application/json

{
    "email": "{{ADMIN_EMAIL}}",
    "password": "{{ADMIN_PASSWORD}}"
}

### Extract Token
@token = {{adminLogin.response.body.token}}

####### ACCOUNT MANAGEMENT #######

### List All Accounts
GET {{APP_URL}}/admin/accounts HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### List Accounts with Filters
GET {{APP_URL}}/admin/accounts
    ?status=pending
    &type=PJ
    &per_page=20
    &page=1 HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Create Individual Account (PF)
# @name createPFAccount
POST {{APP_URL}}/admin/accounts HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "account_type": "PF",
    "name": "João Silva",
    "email": "joao.silva@example.com",
    "cpf": "12345678901",
    "phone": "+5511987654321",
    "usage_types": ["digital_products", "services"],
    "hourly_transaction_limit": 5000.00,
    "daily_transaction_limit": 50000.00
}

### Extract PF Account UUID
@pfAccountUuid = {{createPFAccount.response.body.data.uuid}}

### Create Business Account (PJ)
# @name createPJAccount
POST {{APP_URL}}/admin/accounts HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "account_type": "PJ",
    "account_category": "ecommerce",
    "name": "Tech Solutions LTDA",
    "email": "contact@techsolutions.com",
    "cnpj": "12345678000190",
    "phone": "+5511987654322",
    "usage_types": ["digital_products", "physical_products"],
    "hourly_transaction_limit": 10000.00,
    "daily_transaction_limit": 100000.00
}

### Extract PJ Account UUID
@pjAccountUuid = {{createPJAccount.response.body.data.uuid}}

### Get Account Details
GET {{APP_URL}}/admin/accounts/{{pfAccountUuid}} HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Update Account
PUT {{APP_URL}}/admin/accounts/{{pfAccountUuid}} HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "name": "João Silva Santos",
    "phone": "+5511987654399",
    "usage_types": ["digital_products", "services", "other"]
}

### Get Account Apps
GET {{APP_URL}}/admin/accounts/{{pfAccountUuid}}/apps HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Get Account Wallets
GET {{APP_URL}}/admin/accounts/{{pfAccountUuid}}/wallets HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Get Account Transactions
GET {{APP_URL}}/admin/accounts/{{pfAccountUuid}}/transactions
    ?status=completed
    &from_date=2025-01-01
    &to_date=2025-12-31 HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

####### ACCOUNT STATUS MANAGEMENT #######

### Suspend Account
# @note This suspends the account and blocks all operations
POST {{APP_URL}}/admin/accounts/{{pjAccountUuid}}/suspend HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "reason": "Suspicious activity detected"
}

### Activate Account
POST {{APP_URL}}/admin/accounts/{{pjAccountUuid}}/activate HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "notes": "Issue resolved, account reactivated"
}

### Block Account
# @note This blocks the account due to policy violation
POST {{APP_URL}}/admin/accounts/{{pjAccountUuid}}/block HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "reason": "Terms of service violation",
    "permanent": false
}

####### DOCUMENT VALIDATION #######

### Submit Document for Validation
# @name submitDocument
POST {{APP_URL}}/admin/accounts/{{pfAccountUuid}}/documents HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "document_type": "CPF",
    "document_number": "12345678901",
    "validation_data": {
        "name": "João Silva",
        "birth_date": "1990-05-15"
    }
}

### Extract Document Validation ID
@documentId = {{submitDocument.response.body.data.id}}

### List Account Documents
GET {{APP_URL}}/admin/accounts/{{pfAccountUuid}}/documents HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Approve Document
POST {{APP_URL}}/admin/documents/{{documentId}}/approve HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "notes": "Document validated successfully"
}

### Reject Document
POST {{APP_URL}}/admin/documents/{{documentId}}/reject HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "reason": "Document image is unclear, please resubmit"
}

####### ACCOUNT VERIFICATION #######

### Mark Account as Verified
POST {{APP_URL}}/admin/accounts/{{pfAccountUuid}}/verify HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "verified_by": "admin",
    "notes": "All documents verified successfully"
}

### Get Account Activity Log
GET {{APP_URL}}/admin/accounts/{{pfAccountUuid}}/activity HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Delete Account
# @note This soft deletes the account
DELETE {{APP_URL}}/admin/accounts/{{pjAccountUuid}} HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}
