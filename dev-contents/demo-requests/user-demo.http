####### ENVIRONMENTS #########
@APP_URL = http://localhost:8000
@EMAIL = "user@example.com"
@PASSWORD = "password"

####### REF LINKS #######
# Rest requests demos https://raw.githubusercontent.com/Huachao/vscode-restclient/refs/heads/master/README.md
#######

###
# @name loginForToken
# Login a user to get a token for subsequent requests
POST {{APP_URL}}/api/v1/login HTTP/1.1
Content-Type: application/json
Accept: application/json

{
    "email": "{{EMAIL}}",
    "password": "{{PASSWORD}}"
}

@token = {{loginForToken.response.body.token}}

###
# @name getUser
# Get the authenticated user's information
GET {{APP_URL}}/user HTTP/1.1
Authorization: Bearer {{token}}
Accept: application/json

###
# @name getMe
# Get the authenticated user's information (alternative endpoint)
GET {{APP_URL}}/me HTTP/1.1
Authorization: Bearer {{token}}
Accept: application/json
