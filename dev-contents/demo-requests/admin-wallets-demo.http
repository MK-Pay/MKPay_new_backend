####### ENVIRONMENTS #########
@APP_URL=http://localhost:8000
@ADMIN_EMAIL=admin@mail.com
@ADMIN_PASSWORD=power@123
@ACCOUNT_UUID=
@APP_ID=
#######

####### REF LINKS #######
# Rest requests demos https://raw.githubusercontent.com/Huachao/vscode-restclient/refs/heads/master/README.md
#######

### Admin Login
# @name adminLogin
POST {{APP_URL}}/admin/login HTTP/1.1
Content-Type: application/json
Accept: application/json

{
    "email": "{{ADMIN_EMAIL}}",
    "password": "{{ADMIN_PASSWORD}}"
}

### Extract Token
@token = {{adminLogin.response.body.token}}

####### WALLET MANAGEMENT #######

### List All Wallets
GET {{APP_URL}}/admin/wallets HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### List Account Wallets
GET {{APP_URL}}/admin/accounts/{{ACCOUNT_UUID}}/wallets HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Get Wallet Details
# @name getWallet
GET {{APP_URL}}/admin/wallets/{{WALLET_UUID}} HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Get Wallet Balances
GET {{APP_URL}}/admin/wallets/{{WALLET_UUID}}/balances HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Get Wallet Balance by Currency
GET {{APP_URL}}/admin/wallets/{{WALLET_UUID}}/balances/BRL HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Get Wallet Transactions
GET {{APP_URL}}/admin/wallets/{{WALLET_UUID}}/transactions
    ?from_date=2025-01-01
    &to_date={{$datetime iso8601}}
    &per_page=100 HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Adjust Wallet Balance (Manual)
# @note Use with caution - manually adjusts wallet balance
POST {{APP_URL}}/admin/wallets/{{WALLET_UUID}}/adjust HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "currency": "BRL",
    "amount": 100.00,
    "type": "credit",
    "reason": "Manual adjustment - refund processing error",
    "metadata": {
        "adjusted_by": "admin",
        "ticket_id": "SUPPORT-123"
    }
}

### Release Held Funds
POST {{APP_URL}}/admin/wallets/{{WALLET_UUID}}/release-held-funds HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "currency": "BRL",
    "amount": 500.00,
    "reason": "Account verification completed"
}

####### TRANSACTION MANAGEMENT #######

### List All Transactions
GET {{APP_URL}}/admin/transactions
    ?status=completed
    &type=payment
    &per_page=100
    &page=1 HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Search Transactions
GET {{APP_URL}}/admin/transactions/search
    ?q=maria@example.com
    &from_date=2025-01-01
    &to_date={{$datetime iso8601}} HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Get Transaction Details
GET {{APP_URL}}/admin/transactions/{{TRANSACTION_UUID}} HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Get Transaction Activity Log
GET {{APP_URL}}/admin/transactions/{{TRANSACTION_UUID}}/activity HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Approve Pending Transaction
POST {{APP_URL}}/admin/transactions/{{TRANSACTION_UUID}}/approve HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "notes": "Transaction verified and approved"
}

### Reject Transaction
POST {{APP_URL}}/admin/transactions/{{TRANSACTION_UUID}}/reject HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "reason": "Suspicious activity detected",
    "notes": "Customer notified via email"
}

### Force Complete Transaction
# @note Use with caution - forces transaction to completed state
POST {{APP_URL}}/admin/transactions/{{TRANSACTION_UUID}}/force-complete HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "reason": "Payment confirmed by payment processor",
    "metadata": {
        "processor_transaction_id": "TXN-12345",
        "verified_by": "admin"
    }
}

### Manual Refund
POST {{APP_URL}}/admin/transactions/{{TRANSACTION_UUID}}/refund HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "amount": 150.00,
    "reason": "Customer request - product defect",
    "notify_customer": true
}

### Cancel Transaction
POST {{APP_URL}}/admin/transactions/{{TRANSACTION_UUID}}/cancel HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "reason": "Fraudulent transaction",
    "notes": "Reported by security team"
}

####### CURRENCY EXCHANGE MANAGEMENT #######

### List Exchange Rates
GET {{APP_URL}}/admin/exchange-rates HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Get Active Exchange Rate
GET {{APP_URL}}/admin/exchange-rates/USD/BRL HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Create Exchange Rate
POST {{APP_URL}}/admin/exchange-rates HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "from_currency": "USD",
    "to_currency": "BRL",
    "rate": 5.25,
    "fee_percentage": 2.5,
    "fee_fixed": 1.00,
    "valid_from": "{{$datetime iso8601}}",
    "valid_until": null
}

### Update Exchange Rate
PUT {{APP_URL}}/admin/exchange-rates/{{RATE_ID}} HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "rate": 5.30,
    "fee_percentage": 2.0
}

### Deactivate Exchange Rate
POST {{APP_URL}}/admin/exchange-rates/{{RATE_ID}}/deactivate HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

####### FINANCIAL REPORTS #######

### Transaction Summary Report
GET {{APP_URL}}/admin/reports/transactions/summary
    ?from_date=2025-01-01
    &to_date={{$datetime iso8601}}
    &group_by=day HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Revenue Report
GET {{APP_URL}}/admin/reports/revenue
    ?from_date=2025-01-01
    &to_date={{$datetime iso8601}}
    &currency=BRL HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Fees Report
GET {{APP_URL}}/admin/reports/fees
    ?from_date=2025-01-01
    &to_date={{$datetime iso8601}} HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Payment Methods Report
GET {{APP_URL}}/admin/reports/payment-methods
    ?from_date=2025-01-01
    &to_date={{$datetime iso8601}} HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Account Balances Report
GET {{APP_URL}}/admin/reports/balances
    ?currency=BRL
    &account_status=verified HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Pending Withdrawals Report
GET {{APP_URL}}/admin/reports/pending-withdrawals HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Failed Transactions Report
GET {{APP_URL}}/admin/reports/failed-transactions
    ?from_date=2025-01-01
    &to_date={{$datetime iso8601}} HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

####### WITHDRAWAL MANAGEMENT #######

### List Pending Withdrawals
GET {{APP_URL}}/admin/withdrawals
    ?status=pending HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Get Withdrawal Details
GET {{APP_URL}}/admin/withdrawals/{{WITHDRAWAL_UUID}} HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}

### Approve Withdrawal
POST {{APP_URL}}/admin/withdrawals/{{WITHDRAWAL_UUID}}/approve HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "notes": "Withdrawal verified and processed",
    "bank_transaction_id": "BANK-TXN-123456"
}

### Reject Withdrawal
POST {{APP_URL}}/admin/withdrawals/{{WITHDRAWAL_UUID}}/reject HTTP/1.1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "reason": "Insufficient documentation",
    "notes": "Customer needs to provide additional bank account verification"
}
